generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  ADMIN
  AGENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(AGENT)
  phone        String?
  createdAt    DateTime @default(now())

  assignedConversations Conversation[] @relation("AssignedConversations")
}

model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  conversations Conversation[]
}

enum ConversationStatus {
  AI_HANDLING
  QUEUED
  ASSIGNED
  CLOSED
}

enum Channel {
  WHATSAPP
  INSTAGRAM
}

model Conversation {
  id                 String   @id @default(cuid())
  channel            Channel  @default(WHATSAPP)
  customerExternalId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  status         ConversationStatus @default(AI_HANDLING)
  aiMessageCount Int                @default(0)
  sectorId       String?
  sector         Sector?            @relation(fields: [sectorId], references: [id])
  assignedUserId String?
  assignedUser   User?              @relation("AssignedConversations", fields: [assignedUserId], references: [id])
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  customerName   String?
  profilePictureUrl String?
  originMediaId  String?
  leadPhone      String?
  isLead         Boolean  @default(false)
  crmSyncedAt    DateTime?
  crmSyncError   String?
  reopenPromptSentAt DateTime?
  slaEscalatedAt DateTime?

  messages         Message[]
  outboundMessages OutboundMessage[]

  @@unique([channel, customerExternalId])
  @@index([status])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  direction      MessageDirection
  content        String
  externalId     String?
  createdAt      DateTime          @default(now())

  @@index([conversationId])
}

enum OutboundStatus {
  PENDING
  SENT
  FAILED
}

model OutboundMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id])
  content        String
  status         OutboundStatus  @default(PENDING)
  attempts       Int             @default(0)
  lastError      String?
  createdAt      DateTime        @default(now())
  sentAt         DateTime?

  @@index([status, createdAt])
}

model ProductPage {
  id            String    @id @default(cuid())
  codigo        String    @unique
  url           String    @unique
  content       String    @default("")
  embedding     Unsupported("vector(1536)")?
  lastCrawledAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PostListing {
  id           String   @id @default(cuid())
  mediaId      String   @unique
  postUrl      String
  propertyText String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
